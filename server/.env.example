# Copy this file to server/.env and fill in your own values.
# server/.env is git-ignored and must never be committed.

NODE_ENV=development
PORT=3000

# MongoDB connection string. A local install works fine:
#   DATABASE_URL=mongodb://127.0.0.1:27017/coursecompass
DATABASE_URL=

# Signing key for the sign-in token. Generate a random value:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=7d

# Where the client runs in development (comma separated if more than one).
# In production the server serves the built client itself, so this is not needed.
CLIENT_URL=http://localhost:5173

# Created on first boot if that account does not exist yet.
SUPER_ADMIN_EMAIL=admin@bracu.ac.bd
SUPER_ADMIN_PASSWORD=Admin@1234
